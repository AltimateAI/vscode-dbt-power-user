{
  "comments": {
    "lineComment": "--",
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{#", "#}"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{#", "close": "#}", "notIn": ["string"] },
    { "open": "{%", "close": "%}", "notIn": ["string"] },
    { "open": "{{", "close": "}}", "notIn": ["string"] },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\{%-?\\s*(block|call|docs|filter|for|if|macro|materialization|raw|snapshot|test)\\b(?!.*\\{%-?\\s*end\\1\\b)",
      "end": "^\\s*\\{%-?\\s*end(block|call|docs|filter|for|if|macro|materialization|raw|snapshot|test)\\b"
    }
  }
}
