{
  "comments": {
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{#", "#}"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{#", "close": "#}" },
    { "open": "{%", "close": "%}" },
    { "open": "{{", "close": "}}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["_", "_"],
    ["*", "*"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\{%-?\\s*docs\\b",
      "end": "^\\s*\\{%-?\\s*enddocs\\b"
    }
  }
}
